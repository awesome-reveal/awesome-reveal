{
  "name": "awesome-reveal",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" --parallel build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepare": "husky",
    "test": "vitest run --project \"*:unit\" --project \"*:ssr\" --project \"*:browser\" --project \"*:e2e\"",
    "test:package": "pnpm build && vitest run --project \"*:package\" && pnpm --filter \"./packages/*\" --parallel check:package",
    "test:watch": "vitest --project \"*:unit\" --project \"*:browser\""
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@types/node": "^24.19.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-istanbul": "^5.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.87.0",
    "playwright": "^1.64.1",
    "publint": "^0.3.25",
    "typescript": "^5.7.2",
    "vite": "catalog:",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    }
  }
}
