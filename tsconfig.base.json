{
  "compilerOptions": {
    "lib": ["DOM", "ESNext"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    // Type-checks workspace packages against their sources, so no build is necessary first.
    "paths": {
      "@awesome-reveal/astro": ["./packages/astro/src/index.ts"],
      "@awesome-reveal/core": ["./packages/core/src/index.ts"],
      "@awesome-reveal/core/adapter": ["./packages/core/src/adapter.ts"],
      "@awesome-reveal/react": ["./packages/react/src/index.ts"],
      "@awesome-reveal/test-utils/*": ["./packages/test-utils/src/*.ts"],
      "@awesome-reveal/vue": ["./packages/vue/src/index.ts"]
    },
    // Must contain the sources that the paths add. Without it, vite-plugin-dts logs TS6059 but does not fail.
    "rootDir": ".",
    "skipLibCheck": true,
    "target": "ESNext",
    "verbatimModuleSyntax": true
  }
}
