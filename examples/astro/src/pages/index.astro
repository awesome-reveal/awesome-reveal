---
import { Cascade, Reveal } from "@awesome-reveal/astro";
import PageSection from "../components/PageSection.astro";
import ServerTime from "../components/ServerTime.astro";
import Layout from "../layouts/Layout.astro";
const sides = ["top", "right", "bottom", "left"] as const;
---

<Layout title="awesome-reveal Astro example">
  <PageSection>
    <Reveal id="default">
      <h1>The default entrance</h1>
    </Reveal>
  </PageSection>
  <PageSection>
    <Reveal from={{ opacity: 0 }}>Pure fade</Reveal>
  </PageSection>
  {sides.map((from) => (
    <PageSection>
      <Reveal from={from}>
        From the {from}
      </Reveal>
    </PageSection>
  ))}
  <PageSection>
    <Reveal from={{ scale: 0.9 }}>Scale only</Reveal>
  </PageSection>
  <PageSection>
    <Reveal from="left" class="tilted">
      Keeps its own rotation
    </Reveal>
  </PageSection>
  <PageSection>
    <Reveal
      keyframes={[
        { opacity: 0, transform: "scale(.8)", easing: "ease-out" },
        { opacity: 1, transform: "scale(1)" },
      ]}
    >
      Native keyframes
    </Reveal>
  </PageSection>
  <PageSection>
    <Reveal as="ul" id="list">
      <li>Fast</li>
      <li>Small</li>
      <li>Accessible</li>
    </Reveal>
  </PageSection>
  <PageSection>
    <Cascade as="ul" id="cascade" from={{ opacity: 0, y: 16 }}>
      <li>One</li>
      <li>Two</li>
      <li>Three</li>
    </Cascade>
  </PageSection>
  <PageSection>
    <Reveal as="table" id="table">
      <caption>The whole table reveals together</caption>
      <tbody>
        <tr><th scope="row">First</th><td>One</td></tr>
        <tr><th scope="row">Second</th><td>Two</td></tr>
      </tbody>
    </Reveal>
  </PageSection>
  <PageSection>
    <Reveal as="h2" from="left">
      A header
    </Reveal>
    <Reveal from={{ opacity: 0 }} delay={250}>
      Its content starts 250 ms later
    </Reveal>
  </PageSection>
  <PageSection>
    <Reveal
      as="h2"
      from={{ opacity: 0, blur: 8 }}
      class="title"
      title="A title attribute"
    >
      Your attributes stay on the element
    </Reveal>
  </PageSection>
  <PageSection>
    <ServerTime server:defer>
      <p slot="fallback">Loading the server island...</p>
    </ServerTime>
  </PageSection>
  <PageSection>
    <button type="button" id="toggle" aria-expanded="false">
      Toggle
    </button>
    <output id="reveal-count">0</output> reveals
    <Reveal from={{ opacity: 0, scale: 0.9 }} when={false} hidden id="manual">
      Manual entrance
    </Reveal>
  </PageSection>
  <PageSection>
    <div transition:persist="persisted">
      <Reveal as="h2" id="persisted">
        Persists across navigations
      </Reveal>
    </div>
    <a href="/other">Go to the other page</a>
  </PageSection>
  <PageSection>
    <Reveal as="h2" id="persisted-reveal" transition:persist="persisted-reveal">
      Reveals after navigation
    </Reveal>
  </PageSection>
</Layout>

<script>
  import { getReveal } from "@awesome-reveal/astro";

  document.addEventListener("astro:page-load", () => {
    const toggle = document.querySelector("#toggle");
    const count = document.querySelector("#reveal-count");
    const content = document.querySelector<HTMLElement>("#manual");
    if (!toggle || !content) return;
    const manual = getReveal(content);
    toggle.addEventListener("click", () => {
      const open = !manual.when;
      manual.when = open;
      content.hidden = !open;
      toggle.setAttribute("aria-expanded", String(open));
    });
    content.addEventListener("reveal", () => {
      if (count) count.textContent = String(Number(count.textContent) + 1);
    });
  });
</script>
