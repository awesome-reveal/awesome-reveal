{
  "name": "@awesome-reveal/vue",
  "version": "1.0.0-next.10",
  "description": "Reveal-on-scroll animations for Vue, built on the Web Animations API and IntersectionObserver.",
  "keywords": [
    "animate-on-scroll",
    "animation",
    "directive",
    "fade-in",
    "intersection-observer",
    "reveal",
    "reveal-on-scroll",
    "scroll",
    "scroll-animation",
    "scroll-reveal",
    "typescript",
    "viewport",
    "vue",
    "vue-directive",
    "vue3",
    "waapi",
    "web-animations"
  ],
  "homepage": "https://awesome-reveal.dev",
  "bugs": {
    "url": "https://github.com/awesome-reveal/awesome-reveal/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Dennis Morello",
    "email": "dennismorello@gmail.com",
    "url": "https://morello.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awesome-reveal/awesome-reveal.git",
    "directory": "packages/vue"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/morellodev"
    }
  ],
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "types": "dist/index.d.ts",
  "imports": {
    "#reveal-style.css": {
      "node": {
        "types": "./dist/no-style.d.ts",
        "default": "./dist/no-style.js"
      },
      "default": {
        "types": "./dist/reveal.css.d.ts",
        "default": "./dist/reveal.css"
      }
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./reveal.css": {
      "types": "./dist/reveal.css.d.ts",
      "default": "./dist/reveal.css"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "check:package": "tsc -p test/package && publint --strict && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@awesome-reveal/core": "workspace:^"
  },
  "devDependencies": {
    "vitest-browser-vue": "^3.1.0",
    "vue": "catalog:",
    "vue-tsc": "^3.3.13"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
