---
import { Reveal } from "@awesome-reveal/astro";
---

<html lang="en">
  <head>
    <title>Fixture</title>
  </head>
  <body>
    <Reveal from="left">
      <p>hello</p>
    </Reveal>
    <Reveal as="section" class="box">
      <p>box</p>
    </Reveal>
    <script>
      import { getReveal } from "@awesome-reveal/astro";

      getReveal(document.querySelector(".box")!).when = true;
    </script>
  </body>
</html>
