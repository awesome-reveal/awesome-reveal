{
  "name": "@awesome-reveal/core",
  "version": "1.0.0-next.10",
  "description": "Framework-independent core of awesome-reveal: reveal-on-scroll with IntersectionObserver and the Web Animations API.",
  "keywords": [
    "animate-on-scroll",
    "animation",
    "fade-in",
    "intersection-observer",
    "reveal",
    "reveal-on-scroll",
    "scroll",
    "scroll-animation",
    "scroll-reveal",
    "typescript",
    "vanilla-js",
    "viewport",
    "waapi",
    "web-animations"
  ],
  "homepage": "https://awesome-reveal.dev",
  "bugs": {
    "url": "https://github.com/awesome-reveal/awesome-reveal/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Dennis Morello",
    "email": "dennismorello@gmail.com",
    "url": "https://morello.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awesome-reveal/awesome-reveal.git",
    "directory": "packages/core"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/morellodev"
    }
  ],
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "adapter": [
        "dist/adapter.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "default": "./dist/adapter.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "check:package": "tsc -p test/package && publint --strict && attw --pack . --ignore-rules cjs-resolves-to-esm"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
